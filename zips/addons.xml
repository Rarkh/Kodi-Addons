<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="repository.meinrepo" name="Mein Repo" version="1.0.0" provider-name="Rarkh">
    <extension point="xbmc.addon.repository" name="Mein Repo">
        <dir>
            <info compressed="false">https://Rarkh.github.io/kodi-addons/zips/addons.xml</info>
            <checksum>https://Rarkh.github.io/kodi-addons/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://Rarkh.github.io/kodi-addons/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="de_DE">Mein Kodi-Addon-Repository</summary>
        <description lang="de_DE">Stellt eigene Kodi-Addons über GitHub Pages bereit.</description>
        <platform>all</platform>
    </extension>
</addon>
<addon id="service.watchsync" name="WatchSync" version="0.1.0" provider-name="Rarkh">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="de_DE">Synchronisiert den Wiedergabestatus</summary>
        <summary lang="en_GB">Synchronises watch status</summary>
        <description lang="de_DE">WatchSync läuft als Hintergrunddienst und reagiert auf Wiedergabe-Ereignisse.</description>
        <description lang="en_GB">WatchSync runs as a background service and reacts to playback events.</description>
        <platform>all</platform>
        <license>MIT</license>
    </extension>
</addon>
</addons>
