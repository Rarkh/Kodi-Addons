<?xml version="1.0" encoding="UTF-8"?>
<addon id="repository.rarkh.test" name="Rarkh Repository (Test)" version="1.0.0" provider-name="Rarkh">
    <requires>
        <import addon="xbmc.addon" version="12.0.0"/>
    </requires>
    <extension point="xbmc.addon.repository" name="Rarkh Repository (Test)">
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/Rarkh/Kodi-Addons/dev/repo-test/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/Rarkh/Kodi-Addons/dev/repo-test/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/Rarkh/Kodi-Addons/dev/repo-test/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="de_DE">Rarkh's Test-Kanal (nur für Testgeräte)</summary>
        <summary lang="en_GB">Rarkh's test channel (test devices only)</summary>
        <description lang="de_DE">Liefert Vorabversionen aus dem Branch dev. Nicht zusammen mit dem normalen Rarkh Repository auf demselben Gerät verwenden.</description>
        <description lang="en_GB">Provides pre-release versions from the dev branch. Do not use together with the normal Rarkh Repository on the same device.</description>
        <platform>all</platform>
        <license>MIT</license>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
