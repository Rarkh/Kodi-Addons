                <setting id="storage_path" type="path" label="30002">
                    <level>0</level>
                    <default></default>
                    <constraints>
                        <writable>true</writable>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="button" format="path">
                        <heading>30002</heading>
                    </control>
                </setting>
                <setting id="device_id" type="string" label="30003">
                    <level>0</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30003</heading>
                    </control>
                </setting>
                <setting id="test_connection" type="action" label="30030">
