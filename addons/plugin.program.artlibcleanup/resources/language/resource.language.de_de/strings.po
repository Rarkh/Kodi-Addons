# Kodi Media Center language file
# Addon Name: Art Library Cleanup
# Addon id: plugin.program.artlibcleanup
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: de_DE\n"

msgctxt "#30001"
msgid "General"
msgstr "Allgemein"

msgctxt "#30002"
msgid "Preview only (dry run, delete nothing)"
msgstr "Nur Vorschau (Dry-Run, nichts löschen)"

msgctxt "#30003"
msgid "Include music library"
msgstr "Musikbibliothek einbeziehen"

msgctxt "#30004"
msgid "Show details"
msgstr "Details anzeigen"

msgctxt "#30005"
msgid "Write log to kodi.log"
msgstr "Protokoll in kodi.log schreiben"

msgctxt "#30006"
msgid "When enabled, orphaned images are only listed. Turn this off to be able to delete them."
msgstr "Wenn aktiv, werden verwaiste Bilder nur aufgelistet. Zum Löschen diese Option ausschalten."

msgctxt "#30011"
msgid "Reading library..."
msgstr "Bibliothek wird gelesen..."

msgctxt "#30012"
msgid "Reading image cache..."
msgstr "Bildcache wird gelesen..."

msgctxt "#30020"
msgid "No orphaned images found. Nothing to clean up."
msgstr "Keine verwaisten Bilder gefunden. Nichts zu bereinigen."

msgctxt "#30021"
msgid "Found {0} orphaned cache entries ({1})."
msgstr "{0} verwaiste Cache-Einträge gefunden ({1})."

msgctxt "#30022"
msgid "View details"
msgstr "Details ansehen"

msgctxt "#30023"
msgid "Continue"
msgstr "Weiter"

msgctxt "#30024"
msgid "Preview mode is on (see settings). Nothing was deleted."
msgstr "Der Vorschau-Modus ist aktiv (siehe Einstellungen). Es wurde nichts gelöscht."

msgctxt "#30025"
msgid "Delete these {0} entries ({1}) from the image cache?"
msgstr "Diese {0} Einträge ({1}) aus dem Bildcache löschen?"

msgctxt "#30026"
msgid "Deleting..."
msgstr "Löschen..."

msgctxt "#30027"
msgid "Done: {0} entries removed, {1} freed."
msgstr "Fertig: {0} Einträge entfernt, {1} frei geworden."

msgctxt "#30028"
msgid "Cancelled."
msgstr "Abgebrochen."

msgctxt "#30029"
msgid "Aborted: a library query failed. Nothing was deleted.\n{0}"
msgstr "Abbruch: Eine Abfrage der Bibliothek ist fehlgeschlagen. Es wurde nichts gelöscht.\n{0}"

msgctxt "#30030"
msgid "Aborted: the library is empty. Nothing was deleted."
msgstr "Abbruch: Die Bibliothek ist leer. Es wurde nichts gelöscht."

msgctxt "#30031"
msgid "Skipped (no library entries): {0}"
msgstr "Übersprungen (keine Bibliothekseinträge): {0}"

msgctxt "#30032"
msgid "Video"
msgstr "Video"

msgctxt "#30033"
msgid "Music"
msgstr "Musik"

msgctxt "#30034"
msgid "{0} entries could not be removed."
msgstr "{0} Einträge konnten nicht entfernt werden."

